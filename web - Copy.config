<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- 1. Disable WebDAV module and handler to prevent 405 Method Not Allowed errors on REST APIs -->
    <modules>
      <remove name="WebDAVModule" />
    </modules>
    <handlers>
      <remove name="WebDAV" />
    </handlers>

    <!-- 2. Ensure MIME types for webmanifest, svg, json -->
    <staticContent>
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
    </staticContent>

    <!-- 3. URL Rewrite Rules -->
    <rewrite>
      <rules>
        <!-- Rule A: Force HTTPS and WWW Canonical Domain (301 Permanent Redirect) -->
        <rule name="Redirect to HTTPS and WWW" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAny">
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
            <add input="{HTTP_HOST}" pattern="^innrly\.com$" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://www.innrly.com/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- Rule B: Route /api/* requests to Python backend on port 8000 (stripping /api prefix) -->
        <rule name="API Prefix Reverse Proxy" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8000/{R:1}" />
        </rule>

        <!-- Rule C: Route direct backend endpoints (leads, uploads, telemetry) to Python backend on port 8000 -->
        <rule name="Backend Direct Endpoints" stopProcessing="true">
          <match url="^(leads|uploads|upload|telemetry)(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8000/{R:1}{R:2}" />
        </rule>

        <!-- Rule D: Reverse Proxy all pages, SSR routes, and assets to Node.js server on port 3000 -->
        <rule name="Node Frontend Reverse Proxy" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3000/{R:1}" />
        </rule>
      </rules>
    </rewrite>

    <!-- 4. HTTP Headers: Remove NoIndex Blockers, Server Signatures & Add Security Headers -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Robots-Tag" />
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>

    <!-- 5. Fast Error Responses (Pass Node/Python response codes through) -->
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
