<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <!-- Disable WebDAV module and handler so IIS ARR does not block standard HTTP methods (PUT, DELETE, etc.) -->
        <modules>
            <remove name="WebDAVModule" />
        </modules>
        <handlers>
            <remove name="WebDAV" />
        </handlers>

        <rewrite>
            <rules>
                <!-- 1. Route /api/* requests to Python backend on port 8000 (stripping /api prefix) -->
                <rule name="API Prefix Reverse Proxy" stopProcessing="true">
                    <match url="^api/(.*)" />
                    <action type="Rewrite" url="http://localhost:8000/{R:1}" />
                </rule>

                <!-- 2. Route direct backend endpoints (leads, uploads, telemetry, admin) to Python backend on port 8000 -->
                <rule name="Backend Direct Endpoints" stopProcessing="true">
                    <match url="^(leads|uploads|upload|telemetry|admin)(.*)" />
                    <action type="Rewrite" url="http://localhost:8000/{R:1}{R:2}" />
                </rule>

                <!-- 3. Route all other requests (pages like /integrations/*, /blog/*, /solutions/*, SSR, assets) to Node.js frontend on port 3000 -->
                <rule name="Node Frontend Reverse Proxy" stopProcessing="true">
                    <match url="(.*)" />
                    <action type="Rewrite" url="http://localhost:3000/{R:1}" />
                </rule>
            </rules>
        </rewrite>
    </system.webServer>
</configuration>
