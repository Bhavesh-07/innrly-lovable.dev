<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <!-- =========================================================
        WebDAV
        Remove WebDAV so PUT / DELETE / PATCH requests can
        reach the backend without IIS WebDAV interference.
        ========================================================== -->
        <modules>
            <remove name="WebDAVModule" />
        </modules>
        <handlers>
            <remove name="WebDAV" />
        </handlers>

        <!-- Static content mime type for webmanifest -->
        <staticContent>
            <remove fileExtension=".webmanifest" />
            <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
        </staticContent>

        <!-- =========================================================
        URL REWRITE
        ========================================================== -->
        <rewrite>
            <rules>
                <!-- =================================================
                1. CANONICAL DOMAIN
                Force HTTP -> HTTPS and WWW -> non-WWW
                ================================================== -->
                <rule name="Canonical HTTPS Non-WWW" stopProcessing="true">
                    <match url="(.*)" />
                    <conditions logicalGrouping="MatchAny">
                        <!-- HTTP -> HTTPS -->
                        <add input="{HTTPS}" pattern="^OFF$" ignoreCase="true" />
                        <!-- WWW -> non-WWW -->
                        <add input="{HTTP_HOST}" pattern="^www\.innrly\.com$" ignoreCase="true" />
                    </conditions>
                    <action type="Redirect" url="https://innrly.com/{R:1}" redirectType="Permanent" appendQueryString="true" />
                </rule>

                <!-- =================================================
                2. API
                /api/users -> http://localhost:8005/users
                /api/login -> http://localhost:8005/login
                /api/leads/123 -> http://localhost:8005/leads/123
                ================================================== -->
                <rule name="API Reverse Proxy" stopProcessing="true">
                    <match url="^api/(.*)" ignoreCase="true" />
                    <action type="Rewrite" url="http://localhost:8005/{R:1}" appendQueryString="true" />
                </rule>

                <!-- =================================================
                3. PYTHON BACKEND DIRECT ENDPOINTS
                /leads, /uploads, /upload, /telemetry, /admin
                ================================================== -->
                <rule name="Python Backend Direct Endpoints" stopProcessing="true">
                    <match url="^(leads|uploads?|telemetry|admin)(/.*)?$" ignoreCase="true" />
                    <action type="Rewrite" url="http://localhost:8005/{R:0}" appendQueryString="true" />
                </rule>

                <!-- =================================================
                4. NODE.JS FRONTEND
                Everything else goes to Node.js on port 3000
                ================================================== -->
                <rule name="Node Frontend Reverse Proxy" stopProcessing="true">
                    <match url="(.*)" ignoreCase="true" />
                    <action type="Rewrite" url="http://localhost:3000/{R:1}" appendQueryString="true" />
                </rule>
            </rules>
        </rewrite>

        <!-- =========================================================
        SECURITY / SERVER
        ========================================================== -->
        <security>
            <requestFiltering allowDoubleEscaping="false" />
        </security>
    </system.webServer>
</configuration>
