<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <!-- Disable WebDAV module and handler so IIS ARR does not block standard HTTP methods (PUT, DELETE, etc.) -->
        <modules>
            <remove name="WebDAVModule" />
        </modules>
        <handlers>
            <remove name="WebDAV" />
        </handlers>

        <staticContent>
            <remove fileExtension=".webmanifest" />
            <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
        </staticContent>

        <rewrite>
            <rules>
                <!-- 1. Force HTTPS and Non-WWW canonical redirect -->
                <rule name="Force HTTPS and Non-WWW" stopProcessing="true">
                    <match url="(.*)" />
                    <conditions logicalGrouping="MatchAny">
                        <add input="{HTTPS}" pattern="^OFF$" />
                        <add input="{HTTP_HOST}" pattern="^www\.innrly\.com$" />
                    </conditions>
                    <action type="Redirect" url="https://innrly.com/{R:1}" redirectType="Permanent" appendQueryString="true" />
                </rule>

                <!-- 2. Route /api/* requests to Python backend on port 8005 (stripping /api prefix) -->
                <rule name="API Prefix Reverse Proxy" stopProcessing="true">
                    <match url="^api/(.*)" />
                    <action type="Rewrite" url="http://localhost:8005/{R:1}" />
                </rule>

                <!-- 3. Route direct backend endpoints (leads, uploads, telemetry, admin) to Python backend on port 8005 -->
                <rule name="Backend Direct Endpoints" stopProcessing="true">
                    <match url="^(leads|uploads|upload|telemetry|admin)(.*)" />
                    <action type="Rewrite" url="http://localhost:8005/{R:1}{R:2}" />
                </rule>

                <!-- 4. Route all other requests (pages like /integrations/*, /blog/*, /solutions/*, SSR, assets) to Node.js frontend on port 3000 -->
                <rule name="Node Frontend Reverse Proxy" stopProcessing="true">
                    <match url="(.*)" />
                    <action type="Rewrite" url="http://localhost:3000/{R:1}" />
                </rule>
            </rules>
        </rewrite>
    </system.webServer>
</configuration>
